<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. The Firebase emulator suite (-PrecipeEmulatorHost, functions/README.md)
     speaks plain HTTP, which Android refuses by default; this allows it to the emulator's host
     addresses and nowhere else. Release builds have no network security config. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
