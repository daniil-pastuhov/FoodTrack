<?xml version="1.0" encoding="utf-8"?>
<!-- No updatePeriodMillis: the widget is refreshed on-demand by WidgetUpdater whenever
     pantry or shopping-list data changes, since the OS's own periodic update has a
     30-minute floor. Taller default than the single-list widgets since it shows two
     sections. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="220dp"
    android:targetCellWidth="3"
    android:targetCellHeight="4"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_overview_description" />
