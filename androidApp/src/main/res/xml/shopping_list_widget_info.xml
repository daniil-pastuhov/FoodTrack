<?xml version="1.0" encoding="utf-8"?>
<!-- No updatePeriodMillis: the widget is refreshed on-demand by WidgetUpdater whenever the
     shopping list changes, since the OS's own periodic update has a 30-minute floor. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@drawable/widget_preview_shopping_list"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_shopping_list_description" />
