<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the teal used in ic_launcher_background.xml -->
    <color name="notification_accent">#14B8A6</color>

    <!-- Glance widgets don't follow the Compose Material theme, so these mirror
         ui/theme/Color.kt's LightColorScheme by hand rather than pulling in glance-material3.
         The values-night variant mirrors DarkColorScheme so widgets follow the system
         color scheme the same way the in-app UI does. -->
    <color name="widget_background">#FFFFFFFF</color>
    <color name="widget_on_background">#FF1C1B1F</color>
    <color name="widget_on_background_muted">#FF6E6E73</color>
    <color name="widget_divider">#FFE2E8F0</color>
    <color name="widget_status_expired">#FFB91C1C</color>
    <color name="widget_status_expiring">#FF92400E</color>
</resources>
