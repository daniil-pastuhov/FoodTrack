<!-- Status-bar/notification icon: a milk-carton silhouette so expiry alerts read as
     FoodTracker at a glance instead of the generic system alert glyph. Must stay a flat
     single-color shape - Android masks this to the notification's alpha channel only. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M8,21 L8,9 L12,4 L16,9 L16,21 Z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M11,2 L13,2 L13,4 L11,4 Z" />
</vector>
