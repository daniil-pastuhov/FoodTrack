<?xml version="1.0" encoding="utf-8"?>
<!--
  Resources the release build's resource shrinker must keep although no code or XML refers to
  them by R id.

  default_web_client_id: generated by the google-services plugin from google-services.json's web
  OAuth client. FirebaseRecipeAccount looks it up by NAME (getIdentifier), so that a build from a
  google-services.json without a web client still compiles and simply offers no Google sign-in.
  Without this rule the shrinker removes the string from release builds and Google sign-in
  silently disappears there (seen on the Play internal build 1063, 2026-11-15), while debug builds
  keep it.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
