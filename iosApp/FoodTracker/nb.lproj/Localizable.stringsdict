<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>expires_in_days_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Om %d dag</string>
            <key>other</key>
            <string>Om %d dager</string>
        </dict>
    </dict>
    <key>expired_days_ago_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Utløpt for %d dag siden</string>
            <key>other</key>
            <string>Utløpt for %d dager siden</string>
        </dict>
    </dict>
    <key>notif_body_soon_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$@ %2$#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>utløper om %2$d dag. Husk å spise eller fryse det!</string>
            <key>other</key>
            <string>utløper om %2$d dager. Husk å spise eller fryse det!</string>
        </dict>
    </dict>
    <key>receipt_lines_added</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>La til %d vare fra kvitteringen — sjekk den under</string>
            <key>other</key>
            <string>La til %d varer fra kvitteringen — sjekk dem under</string>
        </dict>
    </dict>
    <key>store_reminder_title_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d ting å kjøpe</string>
            <key>other</key>
            <string>%d ting å kjøpe</string>
        </dict>
    </dict>
    <key>store_reminder_more_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>+%d til</string>
            <key>other</key>
            <string>+%d til</string>
        </dict>
    </dict>
    <key>notif_digest_title_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d vare utløper denne uken</string>
            <key>other</key>
            <string>%d varer utløper denne uken</string>
        </dict>
    </dict>
    <key>notif_digest_more_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>+%d til</string>
            <key>other</key>
            <string>+%d til</string>
        </dict>
    </dict>
    <key>expiry_suggestion_remembered_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Som sist · %d dag</string>
            <key>other</key>
            <string>Som sist · %d dager</string>
        </dict>
    </dict>
    <key>expiry_suggestion_category_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>Standard for %1$@ · %2$#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d dag</string>
            <key>other</key>
            <string>%d dager</string>
        </dict>
    </dict>
    <key>category_settings_shelf_life_days_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d d</string>
            <key>other</key>
            <string>%d d</string>
        </dict>
    </dict>
    <key>shopping_list_import_added_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@n@</string>
        <key>n</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>La til %d vare</string>
            <key>other</key>
            <string>La til %d varer</string>
        </dict>
    </dict>
    <key>backup_import_success_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@n@</string>
        <key>n</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Gjenopprettet %d vare</string>
            <key>other</key>
            <string>Gjenopprettet %d varer</string>
        </dict>
    </dict>
    <key>notif_action_still_good_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@n@</string>
        <key>n</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Fortsatt god +%dd</string>
            <key>other</key>
            <string>Fortsatt god +%dd</string>
        </dict>
    </dict>
    <key>batch_queue_count_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@n@</string>
        <key>n</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d vare i kø</string>
            <key>other</key>
            <string>%d varer i kø</string>
        </dict>
    </dict>
    <key>batch_added_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@n@</string>
        <key>n</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>La til %d vare</string>
            <key>other</key>
            <string>La til %d varer</string>
        </dict>
    </dict>
	<key>batch_discard_message_format</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d vare står i kø og er ikke lagt til ennå.</string>
			<key>other</key>
			<string>%d varer står i kø og er ikke lagt til ennå.</string>
		</dict>
	</dict>
</dict>
</plist>
