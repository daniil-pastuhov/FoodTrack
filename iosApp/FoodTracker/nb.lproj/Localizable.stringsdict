<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>expires_in_days_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Om %d dag</string>
            <key>other</key>
            <string>Om %d dager</string>
        </dict>
    </dict>
    <key>expired_days_ago_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Utløpt for %d dag siden</string>
            <key>other</key>
            <string>Utløpt for %d dager siden</string>
        </dict>
    </dict>
    <key>notif_body_soon_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$@ %2$#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>utløper om %2$d dag. Husk å spise eller fryse det!</string>
            <key>other</key>
            <string>utløper om %2$d dager. Husk å spise eller fryse det!</string>
        </dict>
    </dict>
    <key>notif_digest_body_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d vare utløper de neste 7 dagene</string>
            <key>other</key>
            <string>%d varer utløper de neste 7 dagene</string>
        </dict>
    </dict>
    <key>expiry_suggestion_remembered_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Som sist · %d dag</string>
            <key>other</key>
            <string>Som sist · %d dager</string>
        </dict>
    </dict>
    <key>expiry_suggestion_category_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>Standard for %1$@ · %2$#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d dag</string>
            <key>other</key>
            <string>%d dager</string>
        </dict>
    </dict>
    <key>category_settings_shelf_life_days_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d d</string>
            <key>other</key>
            <string>%d d</string>
        </dict>
    </dict>
</dict>
</plist>
