            <string>recipe in your account</string>
            <key>other</key>
            <string>recipes in your account</string>
        </dict>
    </dict>
    <key>recipe_sign_out_message</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Your %d recipe stays in your account. Sign in again to use it. Saved recipes stay on this phone.</string>
            <key>other</key>
            <string>Your %d recipes stay in your account. Sign in again to use them. Saved recipes stay on this phone.</string>
        </dict>
    </dict>
    <key>recipe_delete_message</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
