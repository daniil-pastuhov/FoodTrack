        <key>NSStringLocalizedFormatKey</key>
        <string>%1$@ %2$#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>expires in %2$d day. Make sure to consume it!</string>
            <key>other</key>
            <string>expires in %2$d days. Make sure to consume it!</string>
        </dict>
    </dict>
