<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>BestBefore</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.foodbest.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>foodtracker</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>BestBefore uses the camera to scan barcodes, read expiration dates printed on packaging, and photograph food items. Photos stay on your phone.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>BestBefore checks whether you are at one of the shops you saved so it can show your shopping list when you get there. This only works while the app is closed if you allow it all the time. BestBefore doesn't send your location to us or share it with anyone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>BestBefore uses your location once, when you tap "Save my current location", to remember where a shop is. The location is stored on your phone, and BestBefore doesn't send it to us or share it with anyone.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeCapturePhoto</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Scan a barcode</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Scan</string>
			<key>UIApplicationShortcutItemType</key>
			<string>scan</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeAdd</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Add an item by hand</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Add item</string>
			<key>UIApplicationShortcutItemType</key>
			<string>add-item</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeTaskCompleted</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Open shopping list</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Shopping</string>
			<key>UIApplicationShortcutItemType</key>
			<string>shopping-list</string>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
