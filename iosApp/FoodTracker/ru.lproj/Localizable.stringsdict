<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>expires_in_days_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Через %d день</string>
            <key>few</key>
            <string>Через %d дня</string>
            <key>many</key>
            <string>Через %d дней</string>
            <key>other</key>
            <string>Через %d дня</string>
        </dict>
    </dict>
    <key>expired_days_ago_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Просрочено %d день назад</string>
            <key>few</key>
            <string>Просрочено %d дня назад</string>
            <key>many</key>
            <string>Просрочено %d дней назад</string>
            <key>other</key>
            <string>Просрочено %d дня назад</string>
        </dict>
    </dict>
    <key>notif_body_soon_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$@ %2$#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>истекает через %2$d день. Не забудьте съесть или заморозить его!</string>
            <key>few</key>
            <string>истекает через %2$d дня. Не забудьте съесть или заморозить его!</string>
            <key>many</key>
            <string>истекает через %2$d дней. Не забудьте съесть или заморозить его!</string>
            <key>other</key>
            <string>истекает через %2$d дня. Не забудьте съесть или заморозить его!</string>
        </dict>
    </dict>
    <key>notif_digest_body_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d продукт истекает в течение следующих 7 дней</string>
            <key>few</key>
            <string>%d продукта истекают в течение следующих 7 дней</string>
            <key>many</key>
            <string>%d продуктов истекают в течение следующих 7 дней</string>
            <key>other</key>
            <string>%d продукта истекают в течение следующих 7 дней</string>
        </dict>
    </dict>
    <key>expiry_suggestion_remembered_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Как в прошлый раз · %d день</string>
            <key>few</key>
            <string>Как в прошлый раз · %d дня</string>
            <key>many</key>
            <string>Как в прошлый раз · %d дней</string>
            <key>other</key>
            <string>Как в прошлый раз · %d дня</string>
        </dict>
    </dict>
    <key>expiry_suggestion_category_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>Стандарт для «%1$@» · %2$#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d день</string>
            <key>few</key>
            <string>%d дня</string>
            <key>many</key>
            <string>%d дней</string>
            <key>other</key>
            <string>%d дня</string>
        </dict>
    </dict>
    <key>category_settings_shelf_life_days_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d д</string>
            <key>few</key>
            <string>%d д</string>
            <key>many</key>
            <string>%d д</string>
            <key>other</key>
            <string>%d д</string>
        </dict>
    </dict>
    <key>shopping_list_import_added_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@n@</string>
        <key>n</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Добавлен %d товар</string>
            <key>few</key>
            <string>Добавлено %d товара</string>
            <key>many</key>
            <string>Добавлено %d товаров</string>
            <key>other</key>
            <string>Добавлено %d товара</string>
        </dict>
    </dict>
    <key>backup_import_success_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@n@</string>
        <key>n</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Восстановлен %d товар</string>
            <key>few</key>
            <string>Восстановлено %d товара</string>
            <key>many</key>
            <string>Восстановлено %d товаров</string>
            <key>other</key>
            <string>Восстановлено %d товара</string>
        </dict>
    </dict>
    <key>notif_action_still_good_format</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@n@</string>
        <key>n</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Ещё годен +%dд</string>
            <key>few</key>
            <string>Ещё годен +%dд</string>
            <key>many</key>
            <string>Ещё годен +%dд</string>
            <key>other</key>
            <string>Ещё годен +%dд</string>
        </dict>
    </dict>
</dict>
</plist>
