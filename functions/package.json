{
  "name": "foodtracker-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@google/genai": "^3.3.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "firebase-tools": "^15.36.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "firebase emulators:exec --only auth,firestore --project demo-foodtracker 'vitest run'",
    "serve": "npm run build && firebase emulators:start --only functions,auth,firestore,pubsub --project demo-foodtracker"
  }
}
