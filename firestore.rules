rules_version = '2';

// Firestore is server-only: the Cloud Functions in functions/ reach it through the Admin SDK,
// which bypasses these rules. No client reads or writes anything, and the apps do not link the
// Firestore SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
